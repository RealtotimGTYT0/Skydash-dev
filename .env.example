# Copy to .env (local) or set these in Vercel > Project > Settings > Environment Variables. Never commit .env.

# Neon: use the DIRECT connection string for running migrations from your PC; the same string also works on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Shared secret between the website and the Minecraft plugin (32+ characters). Generate: openssl rand -hex 32
# On Windows without openssl: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKENSTORE_SERVER_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"

# The public address of the website (origin only). Used to verify form submissions come from this site.
SITE_URL="https://your-project.vercel.app"
